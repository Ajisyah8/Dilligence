<odoo>
    <record id="res_partner_view_form_diligence_referral" model="ir.ui.view">
        <field name="name">res.partner.form.diligence.referral</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Diligence Affiliate" name="diligence_affiliate">
                    <group>
                        <group string="Affiliate Profile">
                            <field name="diligence_is_affiliate"/>
                            <field name="diligence_referral_code" readonly="1"/>
                            <field name="diligence_referral_link" widget="url" readonly="1" invisible="not diligence_is_affiliate"/>
                            <field name="diligence_affiliate_type_id" invisible="not diligence_is_affiliate" options="{'no_quick_create': False, 'no_create_edit': False}"/>
                            <field name="diligence_affiliate_type" invisible="True"/>
                            <field name="diligence_affiliate_start_date" invisible="not diligence_is_affiliate"/>
                            <field name="diligence_affiliate_end_date" invisible="not diligence_is_affiliate"/>
                            <field name="diligence_affiliate_program_ids" widget="many2many_tags" invisible="not diligence_is_affiliate"/>
                            <field name="diligence_referral_count"/>
                            <field name="diligence_valid_referral_count"/>
                            <field name="diligence_cashback_total"/>
                            <field name="diligence_cashback_outstanding"/>
                        </group>
                        <group string="Cashback Rules">
                            <field name="diligence_cashback_type_id" invisible="not diligence_is_affiliate" options="{'no_quick_create': False, 'no_create_edit': False}"/>
                            <field name="diligence_cashback_type" invisible="True"/>
                            <field name="diligence_cashback_rate" invisible="not diligence_is_affiliate or (diligence_cashback_type_id.code != 'percent' and diligence_cashback_type != 'percent')"/>
                            <field name="diligence_cashback_fixed" invisible="not diligence_is_affiliate or (diligence_cashback_type_id.code != 'fixed' and diligence_cashback_type != 'fixed')"/>
                            <field name="diligence_affiliate_min_payout" invisible="not diligence_is_affiliate"/>
                            <field name="diligence_affiliate_waiting_days" invisible="not diligence_is_affiliate"/>
                        </group>
                    </group>
                    <group string="Bank Details" invisible="not diligence_is_affiliate">
                        <group>
                            <field name="diligence_affiliate_bank_name"/>
                            <field name="diligence_affiliate_bank_account"/>
                        </group>
                        <group>
                            <field name="diligence_affiliate_bank_holder"/>
                            <field name="diligence_affiliate_notes"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//sheet//field[@name='category_id']" position="after">
                <field name="diligence_contact_segment_id"/>
                <field name="diligence_contact_segment" invisible="True"/>
            </xpath>
        </field>
    </record>
    <record id="res_partner_view_tree_diligence_segment" model="ir.ui.view">
        <field name="name">res.partner.list.diligence.segment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='email']" position="after">
                <field name="diligence_referral_code" optional="hide"/>
                <field name="diligence_contact_segment" optional="hide"/>
                <field name="diligence_is_affiliate" optional="hide"/>
                <field name="diligence_referral_count" optional="hide"/>
                <field name="diligence_valid_referral_count" optional="hide"/>
                <field name="diligence_cashback_outstanding" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search_diligence_broadcast" model="ir.ui.view">
        <field name="name">res.partner.search.diligence.broadcast</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="diligence_contact_segment_id" string="Diligence Audience"/>
                <filter name="diligence_students" string="Students" domain="[('diligence_contact_segment', '=', 'student')]"/>
                <filter name="diligence_newsletter_subscribers" string="Newsletter Subscribers" domain="[('diligence_contact_segment', '=', 'newsletter'), ('email', '!=', False)]"/>
                <filter name="diligence_referral_non_students" string="Referral - Non Student" domain="[('diligence_contact_segment', '=', 'referral_non_student')]"/>
                <filter name="diligence_affiliates" string="Affiliates / Referrers" domain="[('diligence_is_affiliate', '=', True)]"/>
                <filter name="diligence_employees" string="Employees" domain="[('employee_ids', '!=', False)]"/>
                <separator/>
                <filter name="diligence_has_email" string="Has Email" domain="[('email', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
