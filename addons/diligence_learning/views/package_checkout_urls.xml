<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="package_checkout_template_urls" inherit_id="website_sale.checkout">
        <xpath expr="//t[@t-set='redirect']" position="attributes">
            <attribute name="t-valuef">/paket-belajar/checkout</attribute>
        </xpath>
    </template>

    <template id="package_payment_template_urls" inherit_id="website_sale.payment">
        <xpath expr="//t[@t-set='redirect']" position="attributes">
            <attribute name="t-valuef">/paket-belajar/payment</attribute>
        </xpath>
    </template>

    <template id="package_address_template_urls" inherit_id="website_sale.address">
        <xpath expr="//a[@href='/shop/address?address_type=billing']" position="attributes">
            <attribute name="href">/paket-belajar/address?address_type=billing</attribute>
        </xpath>
        <xpath expr="//form[@name='address_form']" position="attributes">
            <attribute name="action">/paket-belajar/address/submit</attribute>
            <attribute name="t-att-data-submit-url">'/paket-belajar/address/submit'</attribute>
        </xpath>
        <xpath expr="//a[contains(@href, '/web/login?redirect=/shop/checkout')]" position="attributes">
            <attribute name="href">/web/login?redirect=/paket-belajar/checkout</attribute>
        </xpath>
    </template>

    <template id="package_address_edit_template_urls" inherit_id="website_sale.address_edit_button">
        <xpath expr="//a[@href='/shop/checkout']" position="attributes">
            <attribute name="href">/paket-belajar/checkout</attribute>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, '/shop/address?partner_id=')]" position="attributes">
            <attribute name="t-attf-href">/paket-belajar/address?partner_id={{order.partner_invoice_id.id}}&amp;address_type=billing</attribute>
        </xpath>
    </template>

    <template id="package_cart_template_urls" inherit_id="website_sale.cart">
        <xpath expr="//a[contains(@t-attf-href, '/shop/cart')]" position="attributes">
            <attribute name="t-attf-href">/paket-belajar/cart/?id={{id}}&amp;access_token={{access_token}}&amp;revive_method=squash</attribute>
        </xpath>
    </template>

    <template id="package_checkout_layout_cart_link" inherit_id="website_sale.checkout_layout">
        <xpath expr="//a[@href='/shop/cart']" position="attributes">
            <attribute name="href">/paket-belajar/cart</attribute>
        </xpath>
    </template>
</odoo>
