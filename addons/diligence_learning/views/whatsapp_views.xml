<odoo>
    <record id="res_config_settings_view_form_diligence_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.diligence.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Diligence WhatsApp" name="diligence_whatsapp" data-string="Diligence WhatsApp">
                    <block title="Evolution API">
                        <setting string="Enable Evolution WhatsApp">
                            <field name="diligence_whatsapp_enabled"/>
                        </setting>
                        <setting string="Evolution API URL">
                            <field name="diligence_whatsapp_api_url" placeholder="http://127.0.0.1:8080"/>
                        </setting>
                        <setting string="Evolution Instance">
                            <field name="diligence_whatsapp_instance"/>
                        </setting>
                        <setting string="Evolution API Key">
                            <field name="diligence_whatsapp_api_key" password="True"/>
                        </setting>
                        <setting string="Default Country Code">
                            <field name="diligence_whatsapp_default_country_code"/>
                        </setting>
                        <setting string="Payment Confirmation">
                            <field name="diligence_whatsapp_send_on_payment"/>
                            <div class="text-muted">Send a message after a validated payment unlocks the package.</div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_form_diligence_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.diligence.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='diligence_affiliate']" position="inside">
                <button name="action_diligence_send_whatsapp_test" type="object"
                        string="Test WhatsApp" class="btn-secondary"
                        groups="base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
