<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="diligence_newsletter_stage_view_list" model="ir.ui.view">
        <field name="name">diligence.newsletter.stage.list</field>
        <field name="model">diligence.newsletter.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="delay_days"/>
                <field name="template_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="diligence_newsletter_stage_view_form" model="ir.ui.view">
        <field name="name">diligence.newsletter.stage.form</field>
        <field name="model">diligence.newsletter.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="delay_days"/>
                        <field name="template_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="diligence_newsletter_delivery_view_list" model="ir.ui.view">
        <field name="name">diligence.newsletter.delivery.list</field>
        <field name="model">diligence.newsletter.delivery</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="sent_at"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_diligence_newsletter_stages" model="ir.actions.act_window">
        <field name="name">Newsletter Stages</field>
        <field name="res_model">diligence.newsletter.stage</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_diligence_newsletter_deliveries" model="ir.actions.act_window">
        <field name="name">Newsletter Deliveries</field>
        <field name="res_model">diligence.newsletter.delivery</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_diligence_newsletter_root" name="Diligence Newsletter" parent="mass_mailing.mass_mailing_menu_root" sequence="80" groups="base.group_system"/>
    <menuitem id="menu_diligence_newsletter_stages" name="Drip Stages" parent="menu_diligence_newsletter_root" action="action_diligence_newsletter_stages" sequence="10" groups="base.group_system"/>
    <menuitem id="menu_diligence_newsletter_deliveries" name="Delivery Log" parent="menu_diligence_newsletter_root" action="action_diligence_newsletter_deliveries" sequence="20" groups="base.group_system"/>
</odoo>
