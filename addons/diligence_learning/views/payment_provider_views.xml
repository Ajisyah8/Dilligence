<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="diligence_payment_provider_bank_journal_form" model="ir.ui.view">
        <field name="name">payment.provider.form.diligence.bank.account</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment_custom.payment_provider_form"/>
        <field name="arch" type="xml">
            <field name="qr_code" position="after">
                <field name="bank_account_id" invisible="custom_mode != 'wire_transfer'"/>
            </field>
        </field>
    </record>
</odoo>
