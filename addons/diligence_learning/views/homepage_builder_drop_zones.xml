<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Keep the homepage editable even when Website Builder stores a
         website-specific copy with a different section structure. -->
    <template id="diligence_homepage_builder_drop_zones" inherit_id="website.homepage" name="Homepage Builder Drop Zones">
        <xpath expr="//div[@id='wrap']/section" position="attributes">
            <attribute name="class" add="oe_structure" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="inside">
            <div class="oe_structure oe_empty diligence-homepage-drop-zone"/>
        </xpath>
    </template>
</odoo>
