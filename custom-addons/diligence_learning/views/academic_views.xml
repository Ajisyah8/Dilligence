<odoo>
    <record id="diligence_slide_channel_kpi_list" model="ir.ui.view">
        <field name="name">slide.channel.diligence.kpi.list</field>
        <field name="model">slide.channel</field>
        <field name="arch" type="xml">
            <list string="Academic KPIs">
                <field name="name"/>
                <field name="diligence_active_student_count"/>
                <field name="diligence_new_student_count"/>
                <field name="diligence_completed_student_count"/>
                <field name="diligence_expiring_student_count"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>
    <record id="diligence_slide_channel_kpi_search" model="ir.ui.view">
        <field name="name">slide.channel.diligence.kpi.search</field>
        <field name="model">slide.channel</field>
        <field name="arch" type="xml">
            <search string="Academic KPIs">
                <field name="name" string="Course"/>
                <filter name="published" string="Published" domain="[('is_published', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="action_diligence_academic_kpi" model="ir.actions.act_window">
        <field name="name">Academic KPIs</field>
        <field name="res_model">slide.channel</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('diligence_slide_channel_kpi_list')})]"/>
        <field name="search_view_id" ref="diligence_slide_channel_kpi_search"/>
    </record>
    <menuitem id="menu_diligence_academic_kpi" name="Academic KPIs"
              parent="website_slides.website_slides_menu_report" action="action_diligence_academic_kpi"
              sequence="4" groups="website_slides.group_website_slides_officer"/>
</odoo>
