<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="diligence_website_student_corner_nav" inherit_id="website.layout">
        <xpath expr="//body" position="inside">
            <t t-set="interview_number" t-value="request.env['diligence.whatsapp.service'].normalize_number(request.env['ir.config_parameter'].sudo().get_param('diligence.whatsapp_number'))"/>
            <a class="btn rounded-pill shadow academy-floating-cta"
               t-att-href="('https://wa.me/' + interview_number + '?text=Halo%20Diligence%20Academy,%20saya%20ingin%20free%20interview') if interview_number else '/contactus'"
               target="_blank" rel="noopener">
                <i class="fa fa-whatsapp me-2" aria-hidden="true"/>
                <span>Schedule Free Interview</span>
            </a>
        </xpath>
    </template>

    <template id="diligence_student_corner_user_dropdown" inherit_id="portal.user_dropdown">
        <xpath expr="//div[contains(@t-attf-class, 'js_usermenu')]/div[@id='o_logout_divider']" position="before">
            <a href="/my" role="menuitem" class="dropdown-item ps-3" id="diligence_student_corner_menu">
                <i class="fa fa-fw fa-graduation-cap me-1 small text-primary-emphasis"/>
                <span>Student Corner</span>
            </a>
        </xpath>
    </template>

    <template id="diligence_portal_security_link" inherit_id="portal.side_content">
        <xpath expr="//a[@href='/my/account']" position="after">
            <a role="button" href="/my/security" class="btn btn-link p-0 mt-2 d-block diligence-security-link">
                <i class="fa fa-shield me-1" aria-hidden="true"/>
                <span>Connection &amp; Security</span>
            </a>
        </xpath>
    </template>

    <!-- Remove the old Website Builder header consultation CTA. The floating
         WhatsApp button is the only interview entry point now. -->
    <template id="diligence_remove_header_consultation" inherit_id="website.header_text_element">
        <xpath expr="//a[contains(@href, '#free-interview')]" position="replace"/>
    </template>
    <template id="diligence_secondary_header_controls" inherit_id="website.template_header_default">
        <xpath expr="//div[@id=&quot;o_main_nav&quot;]/ul[hasclass(&quot;justify-content-end&quot;)]" position="inside">
            <li t-if="request.httprequest.path != &quot;/&quot;" class="nav-item diligence-header-cart">
                <a href="/shop/cart" class="nav-link position-relative" title="Cart">
                    <i class="fa fa-shopping-cart me-1" aria-hidden="true"/>Cart
                    <sup t-att-class="'diligence-header-cart-quantity my_cart_quantity badge bg-primary rounded-pill %s' % ('d-none' if not request.cart.cart_quantity else '')"
                         t-out="request.cart.cart_quantity or 0"/>
                </a>
            </li>
        </xpath>
    </template>

    <!-- Keep the second production domain visually identical to the reference
         domain. SEO metadata remains domain-specific and is not touched here. -->
    <template id="diligence_website2_visual_match" inherit_id="website.layout" priority="100">
        <xpath expr="//body" position="inside">
            <style id="diligence-website2-visual-match">
                html[data-website-id="2"] {
                    --o-color-1: #0AA2C0 !important;
                    --primary: #0AA2C0 !important;
                    --primary-rgb: 10, 162, 192 !important;
                    --dark: #102F3A !important;
                    --o-color-5: #102F3A !important;
                }
                html[data-website-id="2"] .text-primary {
                    color: #0AA2C0 !important;
                }
                html[data-website-id="2"] a:not(.btn):not(.dropdown-item),
                html[data-website-id="2"] .nav-link {
                    color: #102F3A !important;
                }
                html[data-website-id="2"] #wrap > section.s_cover:first-child .academy-hero-photo {
                    width: 78% !important;
                    max-width: 340px !important;
                    height: 360px !important;
                    max-height: 360px !important;
                    object-fit: cover !important;
                    object-position: 50% 12% !important;
                }
                /* The builder stores the old photo dimensions inline. These
                   rules also normalize the hero colors that were previously
                   injected only on website 2. */
                html[data-website-id="2"] #wrap > section.s_cover:first-child .text-uppercase {
                    color: #0AA2C0 !important;
                }
                html[data-website-id="2"] #wrap > section.s_cover:first-child h1,
                html[data-website-id="2"] #wrap > section.s_cover:first-child h2,
                html[data-website-id="2"] #wrap > section.s_cover:first-child h3 {
                    color: #102F3A !important;
                }
                html[data-website-id="2"] #wrap > section.s_cover:first-child .academy-hero-photo + h3 {
                    color: #102F3A !important;
                }
            </style>
            <script>
                (function () {
                    function syncHeroPhoto() {
                        if (!document.body) return;
                        var photos = document.querySelectorAll('#wrap > section.s_cover:first-child .academy-hero-photo');
                        if (document.body.classList.contains('editor_enable')) {
                            // Do not let the custom public layout turn the
                            // image into a non-editable/hidden builder block.
                            photos.forEach(function (photo) {
                                photo.classList.remove('o_not_editable', 'css_non_editable_mode_hidden');
                                photo.removeAttribute('contenteditable');
                                photo.style.setProperty('display', 'block', 'important');
                                photo.style.setProperty('visibility', 'visible', 'important');
                                photo.style.setProperty('opacity', '1', 'important');
                                var imageBlock = photo.closest('.s_image');
                                if (imageBlock) imageBlock.classList.remove('o_not_editable', 'css_non_editable_mode_hidden');
                            });
                            return;
                        }
                        if (!document.documentElement.matches('html[data-website-id="2"]')) return;
                        photos.forEach(function (photo) {
                            photo.style.setProperty('width', '78%', 'important');
                            photo.style.setProperty('max-width', '340px', 'important');
                            photo.style.setProperty('height', '360px', 'important');
                            photo.style.setProperty('max-height', '360px', 'important');
                            photo.style.setProperty('object-fit', 'cover', 'important');
                            photo.style.setProperty('object-position', '50% 12%', 'important');
                        });
                    }
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', syncHeroPhoto, {once: true});
                    } else {
                        syncHeroPhoto();
                    }
                }());
            </script>
        </xpath>
    </template>

</odoo>
