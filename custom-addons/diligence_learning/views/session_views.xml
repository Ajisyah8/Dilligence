<odoo>
    <record id="diligence_session_view_search" model="ir.ui.view">
        <field name="name">diligence.session.search</field>
        <field name="model">diligence.session</field>
        <field name="arch" type="xml">
            <search string="Learning Sessions">
                <field name="name"/>
                <field name="package_id"/>
                <field name="coach_id"/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="upcoming" string="Upcoming" domain="[('start_datetime', '&gt;=', context_today())]"/>
                <group>
                    <filter name="group_package" string="Package" context="{'group_by': 'package_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="diligence_session_view_list" model="ir.ui.view">
        <field name="name">diligence.session.list</field>
        <field name="model">diligence.session</field>
        <field name="arch" type="xml">
            <list string="Learning Sessions">
                <field name="name"/>
                <field name="package_id"/>
                <field name="session_type" widget="badge"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="coach_id"/>
                <field name="attendee_count"/>
                <field name="seats_available"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="diligence_session_view_form" model="ir.ui.view">
        <field name="name">diligence.session.form</field>
        <field name="model">diligence.session</field>
        <field name="arch" type="xml">
            <form string="Learning Session">
                <header>
                    <button name="action_create_zoom_meeting" type="object" string="Create Zoom Meeting"
                            class="btn-primary" invisible="zoom_created"/>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_done" type="object" string="Mark Done" invisible="state != 'scheduled'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="package_id"/>
                            <field name="session_type"/>
                            <field name="coach_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="timezone"/>
                            <field name="capacity"/>
                            <field name="seats_available" readonly="1"/>
                        </group>
                    </group>
                    <group string="Zoom Meeting" name="zoom_meeting_details">
                        <field name="meeting_url" string="Join Meeting URL" widget="url"/>
                        <field name="zoom_meeting_id" readonly="1" invisible="not zoom_created"/>
                        <field name="zoom_password" string="Meeting Password" readonly="1" invisible="not zoom_created"/>
                    </group>
                    <field name="notes"/>
                    <notebook>
                        <page string="Attendees">
                            <field name="attendee_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="sale_order_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Zoom Host Details" invisible="not zoom_created">
                            <group>
                                <field name="zoom_start_url" string="Host Start URL" widget="url" readonly="1"/>
                            </group>
                            <div class="text-muted">
                                Host Start URL is for the coach or administrator. Share the Join Meeting URL with learners.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="diligence_session_attendee_view_list" model="ir.ui.view">
        <field name="name">diligence.session.attendee.list</field>
        <field name="model">diligence.session.attendee</field>
        <field name="arch" type="xml">
            <list string="Session Attendees">
                <field name="session_id"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_diligence_sessions" model="ir.actions.act_window">
        <field name="name">Learning Sessions</field>
        <field name="res_model">diligence.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="diligence_session_view_search"/>
    </record>
    <record id="action_diligence_session_attendees" model="ir.actions.act_window">
        <field name="name">Session Attendees</field>
        <field name="res_model">diligence.session.attendee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="diligence_session_attendee_view_list"/>
    </record>
    <menuitem id="menu_diligence_sessions" name="Learning Sessions"
              parent="website_slides.website_slides_menu_report"
              action="action_diligence_sessions" sequence="7"
              groups="website_slides.group_website_slides_officer"/>

    <record id="slide_channel_partner_view_tree_diligence_achievements" model="ir.ui.view">
        <field name="name">slide.channel.partner.list.diligence.achievements</field>
        <field name="model">slide.channel.partner</field>
        <field name="inherit_id" ref="website_slides.slide_channel_partner_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='completion']" position="after">
                <field name="diligence_package_id" optional="hide"/>
                <field name="diligence_level" optional="hide" widget="badge"/>
                <field name="diligence_certificate_eligible" optional="hide"/>
                <field name="diligence_certificate_issued" optional="hide"/>
                <button name="action_issue_diligence_certificate" type="object"
                        string="Issue Certificate" icon="fa-certificate"
                        invisible="not diligence_certificate_eligible or diligence_certificate_issued"/>
                <button name="action_print_diligence_certificate" type="object"
                        string="Print Certificate" icon="fa-print"
                        invisible="not diligence_certificate_issued"/>
            </xpath>
        </field>
    </record>
</odoo>
