    <record id="diligence_quiz_type_short" model="diligence.quiz.type"><field name="name">Short answer</field><field name="code">short_answer</field><field name="sequence">40</field><field name="supports_choices">False</field><field name="supports_text_answer">True</field></record>
    <record id="diligence_quiz_type_essay" model="diligence.quiz.type"><field name="name">Essay</field><field name="code">essay</field><field name="sequence">50</field><field name="supports_choices">False</field><field name="supports_text_answer">True</field><field name="requires_manual_grading">True</field></record>
