<odoo>
    <record id="diligence_bulk_pdf_upload_form" model="ir.ui.view">
        <field name="name">diligence.bulk.pdf.upload.form</field>
        <field name="model">diligence.bulk.pdf.upload</field>
        <field name="arch" type="xml">
            <form string="Bulk Upload Materials">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <strong>Upload PDF materials</strong>
                        <div>Select or drag up to 50 PDF files. New lessons remain unpublished until you publish them.</div>
                    </div>
                    <group>
                        <field name="course_id" options="{'no_create': True}"/>
                        <field name="section_id" options="{'no_create': True}"/>
                        <field name="result_message" readonly="1" invisible="not result_message"/>
                    </group>
                    <group string="Files to upload" invisible="result_message">
                        <field name="attachment_ids" widget="many2many_binary" options="{'accepted_file_extensions': '.pdf'}" nolabel="1"/>
                    </group>
                    <group string="Upload results" invisible="not line_ids">
                        <field name="line_ids" nolabel="1">
                            <list create="0" delete="0">
                                <field name="filename"/>
                                <field name="file_size" string="Size (bytes)"/>
                                <field name="state" widget="badge" decoration-success="state == 'uploaded'" decoration-danger="state == 'failed'" decoration-warning="state == 'duplicate'"/>
                                <field name="slide_id"/>
                                <field name="error_message"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_upload" type="object" string="Upload" class="btn-primary" invisible="not attachment_ids"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_diligence_bulk_pdf_upload" model="ir.actions.act_window">
        <field name="name">Bulk Upload Materials</field>
        <field name="res_model">diligence.bulk.pdf.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_diligence_bulk_pdf_upload"
              name="Bulk Upload Materials"
              parent="website_slides.website_slides_menu_courses"
              action="action_diligence_bulk_pdf_upload"
              sequence="5"
              groups="website_slides.group_website_slides_manager"/>

    <record id="slide_channel_form_diligence_bulk_upload" model="ir.ui.view">
        <field name="name">slide.channel.form.diligence.bulk.upload</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_bulk_pdf_upload"
                        type="object"
                        string="Bulk Upload Materials"
                        class="btn-secondary"
                        groups="website_slides.group_website_slides_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
