<odoo>
    <record id="diligence_event_registration_import_view_form" model="ir.ui.view">
        <field name="name">diligence.event.registration.import.form</field>
        <field name="model">diligence.event.registration.import</field>
        <field name="arch" type="xml">
            <form string="Import Event Participants from Excel">
                <group>
                    <field name="event_id" options="{'no_create': True}"/>
                    <field name="file_data" filename="file_name" options="{'accepted_file_extensions': '.xlsx'}"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <div class="alert alert-info">
                    Download a template for the selected event. It includes the event's current questions as columns.
                    Required questions must be answered, and choice answers must match an available option.
                    Existing registrations with the same email are skipped.
                </div>
                <footer>
                    <button name="action_download_template" type="object" string="Download Excel Template" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Import Participants" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_diligence_event_registration_import" model="ir.actions.act_window">
        <field name="name">Import Participants from Excel</field>
        <field name="res_model">diligence.event.registration.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_diligence_event_registration_import"
              name="Import Participants from Excel"
              parent="event.menu_reporting_events"
              action="action_diligence_event_registration_import"
              sequence="70"
              groups="event.group_event_user"/>
</odoo>
