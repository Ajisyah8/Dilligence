<odoo>
    <record id="group_diligence_invoice_officer" model="res.groups">
        <field name="name">Invoice Officer</field>
        <field name="comment">May view unpaid customer invoices, payment status, and queue invoice emails. No accounting reports or configuration.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_diligence_invoice_officer_payment_pending" model="ir.rule">
        <field name="name">Invoice Officer sees pending payment transactions</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="groups" eval="[(4, ref('diligence_learning.group_diligence_invoice_officer'))]"/>
        <field name="domain_force">[('state', 'not in', ('done', 'cancelled', 'error'))]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_diligence_invoice_officer_unpaid" model="ir.rule">
        <field name="name">Invoice Officer sees unpaid customer invoices only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('diligence_learning.group_diligence_invoice_officer'))]"/>
        <field name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund')), ('payment_state', 'in', ('not_paid', 'partial', 'in_payment'))]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="group_diligence_community_member" model="res.groups">
        <field name="name">Diligence Community Member</field>
        <field name="comment">Granted automatically to buyers of Community and Consultation packages.</field>
    </record>

    <record id="rule_diligence_quiz_attempt_student_own" model="ir.rule">
        <field name="name">Students see their own quiz attempts</field>
        <field name="model_id" ref="model_diligence_quiz_attempt"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
    </record>
    <record id="rule_diligence_quiz_response_student_own" model="ir.rule">
        <field name="name">Students see their own quiz answers</field>
        <field name="model_id" ref="model_diligence_quiz_response"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('attempt_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
    </record>
    <record id="rule_diligence_learning_activity_student_own" model="ir.rule">
        <field name="name">Students see their own learning activity</field>
        <field name="model_id" ref="model_diligence_learning_activity"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
    </record>
</odoo>
