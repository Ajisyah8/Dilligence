<odoo>
    <record id="view_diligence_academic_enrollment_search" model="ir.ui.view">
        <field name="name">slide.channel.partner.search.diligence.enrollment</field>
        <field name="model">slide.channel.partner</field>
        <field name="arch" type="xml">
            <search string="Student Enrollment">
                <field name="partner_id" string="Student/User"/>
                <field name="channel_id" string="Course"/>
                <field name="member_status" string="Enrollment Status"/>
                <filter name="active_members" string="Active Members"
                        domain="[('member_status', '=', 'joined')]"/>
                <filter name="completed_members" string="Completed"
                        domain="[('member_status', '=', 'completed')]"/>
                <group>
                    <filter name="group_student" string="Student/User" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_course" string="Course" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_status" string="Enrollment Status" context="{'group_by': 'member_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_diligence_academic_dashboard" model="ir.actions.act_window">
        <field name="name">Academic Dashboard</field>
        <field name="res_model">slide.channel.partner</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_diligence_academic_enrollment_search"/>
        <field name="context">{'group_by': 'channel_id'}</field>
    </record>

    <menuitem id="menu_diligence_academic_dashboard"
              name="Academic Dashboard"
              parent="website_slides.website_slides_menu_report"
              action="action_diligence_academic_dashboard"
              sequence="5"
              groups="website_slides.group_website_slides_officer"/>

    <record id="action_diligence_marketing_dashboard" model="ir.actions.act_window">
        <field name="name">Marketing &amp; Referral Dashboard</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
        <field name="context">{'group_by': 'diligence_referrer_id'}</field>
    </record>

    <menuitem id="menu_diligence_marketing_dashboard"
              name="Marketing &amp; Referral"
              parent="sale.menu_sale_report"
              action="action_diligence_marketing_dashboard"
              sequence="5"
              groups="sales_team.group_sale_salesman"/>
</odoo>
