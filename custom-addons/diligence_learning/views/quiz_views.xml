<odoo>
    <record id="diligence_quiz_attempt_tree" model="ir.ui.view">
        <field name="name">diligence.quiz.attempt.tree</field>
        <field name="model">diligence.quiz.attempt</field>
        <field name="arch" type="xml">
            <list>
                <field name="slide_id"/>
                <field name="partner_id"/>
                <field name="attempt_number"/>
                <field name="started_at"/>
                <field name="submitted_at"/>
                <field name="final_score"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="diligence_quiz_attempt_form" model="ir.ui.view">
        <field name="name">diligence.quiz.attempt.form</field>
        <field name="model">diligence.quiz.attempt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_grade" type="object" string="Grade" class="btn-primary" invisible="state != 'pending_review'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="slide_id"/>
                        <field name="partner_id"/>
                        <field name="attempt_number"/>
                        <field name="started_at"/>
                        <field name="submitted_at"/>
                        <field name="auto_score"/>
                        <field name="manual_score"/>
                        <field name="final_score"/>
                        <field name="passing_score"/>
                    </group>
                    <field name="response_ids">
                        <list editable="bottom">
                            <field name="question_id"/>
                            <field name="question_type"/>
                            <field name="text_answer"/>
                            <field name="is_correct"/>
                            <field name="auto_score"/>
                            <field name="manual_score"/>
                            <field name="manual_graded"/>
                            <field name="feedback"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_diligence_quiz_attempt" model="ir.actions.act_window">
        <field name="name">Quiz Attempts</field>
        <field name="res_model">diligence.quiz.attempt</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_diligence_quiz_attempt" name="Quiz Attempts"
              parent="website_slides.website_slides_menu_root"
              action="action_diligence_quiz_attempt"
              groups="website_slides.group_website_slides_officer"/>
</odoo>
