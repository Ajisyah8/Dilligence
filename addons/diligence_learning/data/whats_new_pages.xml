<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="diligence_study_in_china_success_stories_view" name="Study in China Success Stories">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_banner pt80 pb80 o_cc o_cc1"><div class="container"><span class="text-uppercase fw-bold text-primary">Study in China</span><h1 class="display-4 fw-bold mt-3">Cerita siswa yang berhasil melangkah ke universitas di China</h1><p class="lead col-lg-8 mt-3">Kenali pengalaman siswa dalam mempersiapkan bahasa, dokumen, dan proses pendaftaran studi ke China bersama Diligence Academy.</p></div></section>
                <section class="s_three_columns pt64 pb64"><div class="container"><div class="row g-4"><div class="col-lg-4"><div class="card h-100 border-0 shadow-sm rounded-4"><div class="card-body p-4"><h2 class="h4">Persiapan bahasa</h2><p class="text-muted mb-0">Bangun kemampuan Mandarin secara bertahap untuk kebutuhan akademik dan kehidupan sehari-hari.</p></div></div></div><div class="col-lg-4"><div class="card h-100 border-0 shadow-sm rounded-4"><div class="card-body p-4"><h2 class="h4">Pendampingan aplikasi</h2><p class="text-muted mb-0">Dapatkan panduan untuk memahami pilihan program, dokumen, dan tahapan pendaftaran.</p></div></div></div><div class="col-lg-4"><div class="card h-100 border-0 shadow-sm rounded-4"><div class="card-body p-4"><h2 class="h4">Pengalaman siswa</h2><p class="text-muted mb-0">Halaman ini dapat diperbarui oleh tim akademik dengan cerita, foto, dan hasil siswa terbaru.</p></div></div></div></div></div></section>
                <section class="s_cta_box pt64 pb64 o_cc o_cc2"><div class="container text-center"><h2 class="h3">Siap merencanakan studi ke China?</h2><p class="text-muted">Hubungi tim Diligence Academy untuk mendiskusikan tujuan belajar Anda.</p><a href="/contactus" class="btn btn-primary rounded-pill">Konsultasi dengan Tim</a></div></section>
            </div>
        </t>
    </template>
    <record id="page_study_in_china_success_stories" model="website.page">
        <field name="name">Study in China Success Stories</field>
        <field name="url">/study-in-china-success-stories</field>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
        <field name="website_meta_description">Cerita siswa Diligence Academy yang mempersiapkan diri untuk melanjutkan studi ke universitas di China.</field>
        <field name="view_id" ref="diligence_study_in_china_success_stories_view"/>
    </record>

    <template id="diligence_cambridge_exam_schedule_view" name="Cambridge Exam Schedule">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_banner pt80 pb80 o_cc o_cc1"><div class="container"><span class="text-uppercase fw-bold text-warning">Official Cambridge Certification</span><h1 class="display-4 fw-bold mt-3">Jadwal Cambridge English Exam</h1><p class="lead col-lg-8 mt-3">Temukan informasi periode ujian, pendaftaran, dan persiapan sertifikasi Cambridge bersama tim Diligence Academy.</p></div></section>
                <section class="s_text_block pt64 pb64"><div class="container"><h2 class="h3 mb-4">Informasi jadwal ujian</h2><div class="table-responsive"><table class="table table-bordered align-middle"><thead><tr><th>Program</th><th>Periode pendaftaran</th><th>Jadwal ujian</th><th>Status</th></tr></thead><tbody><tr><td>Cambridge English Certification</td><td>Hubungi tim akademik</td><td>Akan diumumkan sesuai kalender ujian</td><td><span class="badge text-bg-warning">Segera hadir</span></td></tr></tbody></table></div><p class="text-muted mt-3">Jadwal resmi dapat berubah mengikuti penyelenggara ujian. Tim Diligence Academy akan memperbarui halaman ini ketika periode pendaftaran dan tanggal ujian sudah dikonfirmasi.</p></div></section>
                <section class="s_cta_box pt64 pb64 o_cc o_cc2"><div class="container text-center"><h2 class="h3">Ingin mempersiapkan diri untuk ujian?</h2><p class="text-muted">Konsultasikan target sertifikasi dan program persiapan yang sesuai.</p><a href="/contactus" class="btn btn-primary rounded-pill">Hubungi Diligence Academy</a></div></section>
            </div>
        </t>
    </template>
    <record id="page_cambridge_exam_schedule" model="website.page">
        <field name="name">Cambridge Exam Schedule</field>
        <field name="url">/cambridge-exam-schedule</field>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
        <field name="website_meta_description">Informasi jadwal dan persiapan Official Cambridge Certification Exam bersama Diligence Academy.</field>
        <field name="view_id" ref="diligence_cambridge_exam_schedule_view"/>
    </record>
</odoo>
