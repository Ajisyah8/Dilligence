<odoo>
    <template id="diligence_auth_signup_phone" inherit_id="auth_signup.signup" name="Signup WhatsApp Number">
        <xpath expr="//div[hasclass('field-login')]" position="after">
            <div class="mb-3 field-phone">
                <label for="phone" class="form-label">WhatsApp Number</label>
                <input type="tel" name="phone" t-att-value="phone" id="phone" class="form-control"
                       placeholder="e.g. 081234567890" required="required"/>
                <div class="form-text">Use an active number so our team can contact you about your learning program.</div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('field-phone')]" position="after">
            <div class="mb-3 field-newsletter-opt-in">
                <div class="form-check">
                    <input type="checkbox" name="diligence_newsletter_opt_in" id="diligence_newsletter_opt_in"
                           class="form-check-input"/>
                    <label for="diligence_newsletter_opt_in" class="form-check-label">
                        I agree to receive learning tips and updates from Diligence Academy.
                    </label>
                </div>
                <div class="form-text">You can unsubscribe at any time.</div>
            </div>
        </xpath>
    </template>
</odoo>
