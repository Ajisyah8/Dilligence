<odoo>
    <record id="payment_qris_reject_wizard_form" model="ir.ui.view">
        <field name="name">payment.qris.reject.wizard.form</field>
        <field name="model">payment.qris.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject QRIS Payment">
                <group>
                    <field name="transaction_id"/>
                    <field name="reason" placeholder="Explain why this payment is rejected..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject Payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
