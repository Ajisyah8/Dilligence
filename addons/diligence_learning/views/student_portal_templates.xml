<odoo>
    <template id="portal_my_courses" name="My Courses">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="True"/>
            <div class="container o_portal_wrap py-4 diligence-student-dashboard">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <div class="text-uppercase small fw-semibold text-primary" t-translation="yes">Diligence Academy</div>
                        <h3 class="mb-0" t-translation="yes">My Courses</h3>
                    </div>
                    <a href="/my/home" class="btn btn-outline-secondary" t-translation="yes">Back to My Account</a>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12 col-lg-4">
                        <div class="diligence-dashboard-card diligence-calendar-card align-self-start">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0" t-translation="yes">Learning Calendar</h5>
                                <span class="text-muted small" t-out="calendar_month_label"/>
                            </div>
                            <div class="diligence-calendar-weekdays">
                                <span t-translation="yes">Mon</span><span t-translation="yes">Tue</span><span t-translation="yes">Wed</span><span t-translation="yes">Thu</span><span t-translation="yes">Fri</span><span t-translation="yes">Sat</span><span t-translation="yes">Sun</span>
                            </div>
                            <div class="diligence-calendar-grid">
                                <t t-foreach="calendar_weeks" t-as="week">
                                    <t t-foreach="week" t-as="cell">
                                        <span t-att-class="'diligence-calendar-day%s%s' % (' is-active' if cell['active'] else '', ' is-today' if cell['today'] else '')">
                                            <t t-if="cell['day']" t-out="cell['day']"/>
                                        </span>
                                    </t>
                                </t>
                            </div>
                            <div class="d-flex justify-content-between align-items-end border-top pt-3 mt-3">
                                <div>
                                    <div class="text-muted small" t-translation="yes">Active days this month</div>
                                    <strong class="fs-4" t-out="monthly_activity_days"/>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted small" t-translation="yes">Total duration this month</div>
                                    <strong><t t-out="monthly_duration_minutes"/> <span t-translation="yes">minutes</span></strong>
                                </div>
                            </div>
                            <div class="text-muted small mt-2" t-translation="yes">Duration is based on completed lesson duration.</div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-8">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0" t-translation="yes">Your learning progress</h5>
                            <span class="text-muted small"><t t-out="len(dashboard_courses)"/> <span t-translation="yes">courses</span></span>
                        </div>
                        <div class="d-flex flex-column gap-3">
                            <t t-foreach="dashboard_courses" t-as="course">
                                <div class="diligence-dashboard-card diligence-course-card">
                                    <div class="d-flex justify-content-between gap-3">
                                        <div class="min-w-0">
                                            <h5 class="mb-1 text-truncate" t-out="course['membership'].channel_id.name"/>
                                            <div class="text-muted small"><t t-out="course['completed']"/> / <t t-out="course['total']"/> <span t-translation="yes">lessons completed</span></div>
                                        </div>
                                        <strong class="diligence-progress-value"><t t-out="round(course['progress'])"/>%</strong>
                                    </div>
                                    <div class="progress mt-3" role="progressbar" t-att-aria-valuenow="course['progress']" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" t-attf-style="width: {{ course['progress'] }}%;"/>
                                    </div>
                                    <div class="mt-3">
                                        <div class="text-muted small mb-2" t-translation="yes">Scores</div>
                                        <div t-if="course['score_boxes']" class="diligence-score-grid">
                                            <t t-foreach="course['score_boxes']" t-as="score">
                                                <span t-att-title="'%s — %s' % (score['name'], dict(passed='Passed', failed='Not passed', pending_review='Waiting for grading', not_started='Not started').get(score['state'], score['state']))"
                                                      t-att-class="'diligence-score-box%s%s%s' % (' is-passed' if score['state'] == 'passed' else '', ' is-pending' if score['state'] == 'pending_review' else '', ' is-failed' if score['state'] == 'failed' else '')">
                                                    <t t-if="score['score'] is not None" t-out="score['score']"/>
                                                    <t t-else="">—</t>
                                                </span>
                                            </t>
                                        </div>
                                        <div t-else="" class="text-muted small" t-translation="yes">No quizzes in this course yet.</div>
                                    </div>
                                    <a class="btn btn-sm btn-outline-primary mt-3 align-self-start" t-att-href="course['membership'].channel_id.website_absolute_url" t-translation="yes">Continue learning</a>
                                </div>
                            </t>
                            <div t-if="not dashboard_courses" class="diligence-dashboard-card text-muted" t-translation="yes">There are no active courses on this account yet.</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        <a href="/my/orders" class="diligence-shortcut-card text-decoration-none">
                            <span class="fa fa-shopping-bag" aria-hidden="true"/><span><strong t-translation="yes">My Orders</strong><small><t t-out="orders_count"/> <span t-translation="yes">orders</span></small></span><span class="fa fa-chevron-right ms-auto" aria-hidden="true"/>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a href="/my/invoices" class="diligence-shortcut-card text-decoration-none">
                            <span class="fa fa-file-text-o" aria-hidden="true"/><span><strong t-translation="yes">My Invoices</strong><small><t t-out="invoices_count"/> <span t-translation="yes">invoices</span></small></span><span class="fa fa-chevron-right ms-auto" aria-hidden="true"/>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a href="/shop/cart" class="diligence-shortcut-card text-decoration-none">
                            <span class="fa fa-shopping-cart" aria-hidden="true"/><span><strong t-translation="yes">My Cart</strong><small><t t-out="cart_count"/> <span t-translation="yes">items</span></small></span><span class="fa fa-chevron-right ms-auto" aria-hidden="true"/>
                        </a>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3"><div class="diligence-mini-stat"><span t-translation="yes">Active courses</span><strong t-out="len(dashboard_courses)"/></div></div>
                    <div class="col-6 col-lg-3"><div class="diligence-mini-stat"><span t-translation="yes">Current streak</span><strong><t t-out="current_streak"/> <small t-translation="yes">days</small></strong></div></div>
                    <div class="col-6 col-lg-3"><div class="diligence-mini-stat"><span t-translation="yes">Best streak</span><strong><t t-out="best_streak"/> <small t-translation="yes">days</small></strong></div></div>
                    <div class="col-6 col-lg-3"><div class="diligence-mini-stat"><span t-translation="yes">Activities (90 days)</span><strong t-out="len(activities)"/></div></div>
                </div>
                <div class="card shadow-sm mb-4" t-if="upcoming_sessions">
                    <div class="card-body">
                        <h5 t-translation="yes">Upcoming sessions</h5>
                        <div class="list-group list-group-flush">
                            <div class="list-group-item px-0" t-foreach="upcoming_sessions" t-as="session">
                                <div class="d-flex justify-content-between gap-3">
                                    <div><strong t-out="session.name"/><br/><span class="text-muted" t-field="session.start_datetime"/></div>
                                    <a t-if="session.meeting_url" class="btn btn-sm btn-outline-primary align-self-center" t-att-href="session.meeting_url" target="_blank" t-translation="yes">Join</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div t-if="not memberships" class="alert alert-info">
                    <span t-translation="yes">There are no active courses on this account. Please make sure the package payment has been confirmed.</span>
                </div>
                <div class="row g-3">
                    <t t-foreach="memberships" t-as="membership">
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title" t-out="membership.channel_id.name"/>
                                    <p class="text-muted mb-2" t-if="membership.diligence_package_id">
                                        <span t-translation="yes">Package:</span> <span t-out="membership.diligence_package_id.name"/>
                                    </p>
                                    <p class="small text-muted" t-if="membership.diligence_access_expires_at">
                                        <span t-translation="yes">Access until:</span> <span t-field="membership.diligence_access_expires_at"/>
                                    </p>
                                    <a class="btn btn-primary mt-auto"
                                       t-att-href="membership.channel_id.website_absolute_url">
                                        <span t-translation="yes">Open Course</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_consultations" name="My Consultation">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="True"/>
            <div class="container o_portal_wrap py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="mb-0" t-translation="yes">My Consultation</h3>
                    <a href="/my/home" class="btn btn-outline-secondary" t-translation="yes">Back to My Account</a>
                </div>
                <div t-if="not orders" class="alert alert-info" t-translation="yes">
                    <span t-translation="yes">There is no confirmed Consultation package purchase on this account.</span>
                </div>
                <div t-foreach="orders" t-as="order" class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <h5 class="mb-0"><span t-translation="yes">Consultation</span> - <span t-out="order.name"/></h5>
                            <span class="badge text-bg-info" t-out="dict(order._fields['diligence_consultation_status'].selection).get(order.diligence_consultation_status)"/>
                        </div>
                        <hr/>
                        <div class="row g-3">
                            <div class="col-md-4" t-if="order.diligence_coach_id">
                                <strong t-translation="yes">Coach</strong><br/>
                                <span t-out="order.diligence_coach_id.name"/>
                            </div>
                            <div class="col-md-4" t-if="order.diligence_next_coaching_date">
                                <strong t-translation="yes">Next schedule</strong><br/>
                                <span t-field="order.diligence_next_coaching_date"/>
                            </div>
                            <div class="col-12" t-if="order.diligence_coaching_link">
                                <a class="btn btn-primary" t-att-href="order.diligence_coaching_link" target="_blank">
                                    <span t-translation="yes">Open Consultation Link</span>
                                </a>
                            </div>
                            <div class="col-12" t-if="order.diligence_coaching_note">
                                <strong t-translation="yes">Coach note</strong>
                                <p class="mb-0" t-out="order.diligence_coaching_note"/>
                            </div>
                            <div class="col-12" t-if="not order.diligence_coach_id and not order.diligence_next_coaching_date and not order.diligence_coaching_link and not order.diligence_coaching_note">
                                <span class="text-muted" t-translation="yes">The coach will arrange the schedule and contact you.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_home_courses_entry" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <t t-set="diligence_has_consultation"
               t-value="request.env['sale.order'].sudo().search_count([
                   ('partner_id', 'child_of', request.env.user.partner_id.commercial_partner_id.id),
                   ('state', 'in', ('sale', 'done')),
                   ('order_line.product_template_id.diligence_consultation', '=', True)
               ]) &gt; 0"/>
            <div class="o_portal_category row g-2 mt-3" id="diligence_student_category">
                <div class="col-12 col-md-6">
                    <a href="/my/courses" title="My Courses"
                       class="d-flex gap-3 py-3 px-3 h-100 rounded text-decoration-none bg-100">
                        <div class="d-flex align-items-center justify-content-center"
                             style="width: 56px; height: 56px; min-width: 56px;">
                            <img src="/account/static/src/img/multi_ledger.svg" alt="" width="56" height="56"/>
                        </div>
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1" t-translation="yes">My Courses</div>
                            <div class="text-muted" t-translation="yes">Open your courses and learning materials</div>
                        </div>
                    </a>
                </div>
                <div t-if="diligence_has_consultation" class="col-12 col-md-6">
                    <a href="/my/consultation" title="My Consultation"
                       class="d-flex gap-3 py-3 px-3 h-100 rounded text-decoration-none bg-100">
                        <div class="d-flex align-items-center justify-content-center"
                             style="width: 56px; height: 56px; min-width: 56px;">
                            <img src="/event/static/src/img/google-calendar.svg" alt="" width="56" height="56"/>
                        </div>
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1" t-translation="yes">My Consultation</div>
                            <div class="text-muted" t-translation="yes">View your coach, schedule, and consultation link</div>
                        </div>
                    </a>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
