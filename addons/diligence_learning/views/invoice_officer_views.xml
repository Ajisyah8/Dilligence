<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="diligence_invoice_officer_move_form" model="ir.ui.view">
        <field name="name">account.move.form.diligence.invoice.officer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_diligence_send_invoice" type="object" string="Send Invoice"
                        class="btn-secondary" groups="diligence_learning.group_diligence_invoice_officer"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
    <record id="action_diligence_invoice_officer_invoices" model="ir.actions.act_window">
        <field name="name">Unpaid Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('payment_state', 'in', ('not_paid', 'partial', 'in_payment'))]</field>
        <field name="context">{'search_default_unpaid': 1}</field>
    </record>
    <record id="action_diligence_invoice_officer_pending_payments" model="ir.actions.act_window">
        <field name="name">Pending Payments</field>
        <field name="res_model">payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('draft', 'pending', 'authorized')), ('provider_code', '=', 'custom'), ('provider_id.custom_mode', 'in', ('qris_static', 'wire_transfer'))]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <menuitem id="menu_diligence_invoice_officer_root" name="Invoice Officer" sequence="35" groups="diligence_learning.group_diligence_invoice_officer" web_icon="diligence_learning,static/description/invoice_officer_icon.svg"/>
    <menuitem id="menu_diligence_invoice_officer_invoices" name="Unpaid Customer Invoices" parent="menu_diligence_invoice_officer_root" action="action_diligence_invoice_officer_invoices" sequence="10" groups="diligence_learning.group_diligence_invoice_officer"/>
    <menuitem id="menu_diligence_invoice_officer_pending_payments" name="Pending Payments" parent="menu_diligence_invoice_officer_root" action="action_diligence_invoice_officer_pending_payments" sequence="20" groups="diligence_learning.group_diligence_invoice_officer"/>
    <!-- The agreed QRIS flow verifies and settles the payment immediately.
         Keep the action and accounting records, but hide this obsolete queue
         from the Invoice Officer navigation. -->
    <record id="menu_diligence_invoice_officer_invoices" model="ir.ui.menu">
        <field name="active">False</field>
    </record>
</odoo>
