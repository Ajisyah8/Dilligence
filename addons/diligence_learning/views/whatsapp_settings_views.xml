<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Community-compatible settings view. It uses the standard form and
         avoids Enterprise-only settings app metadata. -->
    <record id="res_config_settings_view_diligence_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.diligence.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <div class="app_settings_block" data-key="general_settings" data-string="Evolution WhatsApp">
                    <h2>Evolution WhatsApp</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="diligence_whatsapp_enabled"/></div>
                            <div class="o_setting_right_pane">
                                <label for="diligence_whatsapp_enabled" string="Enable Evolution WhatsApp"/>
                                <div class="text-muted">Enable WhatsApp messages through Evolution API.</div>
                            </div>
                        </div>
                    </div>
                    <h2>Connection</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box"><div class="o_setting_right_pane">
                            <div class="mb-3">
                                <label for="diligence_whatsapp_api_url" string="Evolution API URL" class="d-block mb-1"/>
                                <field name="diligence_whatsapp_api_url" placeholder="https://..." class="w-100"/>
                            </div>
                            <div class="mb-3">
                                <label for="diligence_whatsapp_instance" string="Evolution Instance" class="d-block mb-1"/>
                                <field name="diligence_whatsapp_instance" class="w-100"/>
                            </div>
                        </div></div>
                        <div class="col-12 col-lg-6 o_setting_box"><div class="o_setting_right_pane">
                            <div class="mb-3">
                                <label for="diligence_whatsapp_api_key" string="Evolution API Key" class="d-block mb-1"/>
                                <field name="diligence_whatsapp_api_key" password="True" class="w-100"/>
                            </div>
                            <div class="mb-3">
                                <label for="diligence_whatsapp_default_country_code" string="Default Country Code" class="d-block mb-1"/>
                                <field name="diligence_whatsapp_default_country_code" class="w-100"/>
                            </div>
                        </div></div>
                    </div>
                    <h2>Message Templates</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box"><div class="o_setting_right_pane">
                            <label for="diligence_whatsapp_signup_message" string="Signup Welcome Message"/>
                            <div class="text-muted mb8">Use %%(name)s for the contact name.</div>
                            <field name="diligence_whatsapp_signup_message" nolabel="1" widget="text" placeholder="Welcome message"/>
                        </div></div>
                        <div class="col-12 col-lg-6 o_setting_box"><div class="o_setting_right_pane">
                            <label for="diligence_whatsapp_test_message" string="Test WhatsApp Message"/>
                            <div class="text-muted mb8">Use %%(name)s for the contact name.</div>
                            <field name="diligence_whatsapp_test_message" nolabel="1" widget="text" placeholder="Test message"/>
                        </div></div>
                        <div class="col-12 col-lg-12 o_setting_box" invisible="True"><div class="o_setting_right_pane">
                            <label for="diligence_whatsapp_payment_message" string="Payment Confirmation Message"/>
                            <div class="text-muted mb8">Use %%(order)s and %%(group_message)s.</div>
                            <field name="diligence_whatsapp_payment_message" nolabel="1" widget="text" placeholder="Payment confirmation"/>
                        </div></div>
                    </div>
                    <h2>Automation</h2>
                    <div class="row mt16 o_settings_container"><div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"><field name="diligence_whatsapp_send_on_payment"/></div>
                        <div class="o_setting_right_pane"><label for="diligence_whatsapp_send_on_payment" string="Payment Confirmation"/>
                            <div class="text-muted">Send only after payment and course access are valid.</div>
                        </div>
                    </div></div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
