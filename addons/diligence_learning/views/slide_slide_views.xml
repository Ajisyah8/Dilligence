<odoo>
    <record id="slide_slide_form_diligence_external_quiz" model="ir.ui.view">
        <field name="name">slide.slide.form.diligence.external.quiz</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='quiz']//group[@name='quiz_details']" position="inside">
                <group string="Diligence quiz settings" invisible="slide_category != 'quiz'">
                    <field name="quiz_passing_score"/>
                    <field name="quiz_max_attempts"/>
                    <field name="quiz_randomize_questions"/>
                    <field name="quiz_randomize_answers"/>
                </group>
                <group string="External Quiz Form" invisible="slide_category != 'quiz'">
                    <field name="diligence_external_quiz_url" widget="url"
                           placeholder="https://forms.gle/..."/>
                    <field name="diligence_external_quiz_label"
                           placeholder="e.g. Fill in answers on Google Form"/>
                    <div class="text-muted" colspan="2">
                        Paste a Google Form or another external quiz link. Learners can open it from this quiz.
                    </div>
                </group>
            </xpath>
            <xpath expr="//page[@name='quiz']//field[@name='question_ids']/list/field[@name='question']" position="after">
                <field name="question_type"/>
                <field name="weight"/>
                <field name="required"/>
            </xpath>
        </field>
    </record>

    <record id="slide_question_form_diligence_types" model="ir.ui.view">
        <field name="name">slide.question.form.diligence.types</field>
        <field name="model">slide.question</field>
        <field name="inherit_id" ref="website_slides.slide_question_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='question']" position="after">
                <field name="question_type"/>
                <field name="weight"/>
                <field name="required"/>
                <field name="allow_partial_score" invisible="question_type not in ('multiple_choice', 'listening')"/>
                <field name="short_answer_variants" invisible="question_type not in ('short_answer', 'listening')"/>
                <field name="short_answer_ignore_punctuation" invisible="question_type not in ('short_answer', 'listening')"/>
                <field name="short_answer_ignore_accents" invisible="question_type not in ('short_answer', 'listening')"/>
                <field name="listening_answer_type" invisible="question_type != 'listening'"/>
                <field name="audio_file" filename="audio_filename" invisible="question_type not in ('listening', 'speaking')"/>
                <field name="audio_filename" invisible="1"/>
                <field name="max_audio_plays" invisible="question_type not in ('listening', 'speaking')"/>
                <field name="feedback_after_submit"/>
                <field name="grading_rubric" invisible="question_type not in ('essay', 'speaking')"/>
            </xpath>
        </field>
    </record>

    <template id="lesson_content_quiz_external_form"
              inherit_id="website_slides.lesson_content_quiz"
              name="Diligence: External quiz form link">
        <xpath expr="//div[@id='lessonQuiz']/t[@t-foreach='slide_questions']" position="before">
            <div t-if="slide.diligence_external_quiz_url" class="alert alert-info d-flex flex-wrap align-items-center gap-2 mb-3">
                <i class="fa fa-external-link"/>
                <span>Complete this quiz using the external form.</span>
                <a t-att-href="slide.diligence_external_quiz_url"
                   target="_blank" rel="noopener noreferrer"
                   class="btn btn-primary btn-sm ms-auto">
                    <i class="fa fa-wpforms me-1"/>
                    <t t-out="slide.diligence_external_quiz_label or 'Open External Quiz'"/>
                </a>
            </div>
        </xpath>
    </template>

    <template id="lesson_content_quiz_multitype_marker"
              inherit_id="website_slides.lesson_content_quiz"
              name="Diligence: Multi-type quiz marker">
        <xpath expr="//div[@id='lessonQuiz']" position="attributes">
            <attribute name="class" add="o_diligence_multitype_quiz" separator=" "/>
            <attribute name="data-diligence-multitype">1</attribute>
        </xpath>
    </template>

    <template id="lesson_content_quiz_question_multitype"
              inherit_id="website_slides.lesson_content_quiz_question"
              name="Diligence: Multi-type quiz question content">
        <xpath expr="//div[@t-att-class]" position="attributes">
            <attribute name="t-att-data-required">question.get('required', True)</attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' list-group ')]" position="attributes">
            <attribute name="t-if">question['question_type'] == 'single_choice'</attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' list-group ')]" position="after">
            <div t-if="question['question_type'] != 'single_choice'" class="o_diligence_quiz_answer_group list-group"
                 t-att-data-question-type="question['question_type']">
                <div t-if="question['question_type'] == 'listening' and question.get('audio_url')" class="alert alert-light border d-flex align-items-center gap-2">
                    <i class="fa fa-volume-up text-primary" aria-hidden="true"/>
                    <audio controls="controls" preload="metadata" t-att-src="question['audio_url']" class="w-100"/>
                </div>
                <div t-if="question['question_type'] in ('short_answer', 'essay') or (question['question_type'] == 'listening' and question.get('listening_answer_type') == 'short_answer')" class="p-3 border rounded">
                    <textarea t-if="question['question_type'] == 'essay'" class="form-control o_diligence_quiz_text_answer" rows="5" t-att-data-question-id="question['id']" placeholder="Write your answer..."/>
                    <input t-else="" type="text" class="form-control o_diligence_quiz_text_answer" t-att-data-question-id="question['id']" placeholder="Type your answer..."/>
                </div>
                <t t-if="question['question_type'] not in ('short_answer', 'essay') and not (question['question_type'] == 'listening' and question.get('listening_answer_type') == 'short_answer')">
                    <label t-foreach="question['answer_ids']" t-as="answer" class="o_diligence_quiz_choice list-group-item d-flex align-items-center gap-2">
                        <input t-att-type="'checkbox' if question['question_type'] == 'multiple_choice' else 'radio'"
                               t-att-name="'diligence_question_%s' % question['id']"
                               t-att-value="answer['id']" class="o_diligence_quiz_choice_input"
                               t-att-data-question-id="question['id']"/>
                        <span t-out="answer['text_value']"/>
                    </label>
                </t>
            </div>
        </xpath>
    </template>

    <template id="slide_content_detailed_external_quiz_preview"
              inherit_id="website_slides.slide_content_detailed"
              name="Diligence: External quiz preview">
        <xpath expr="//div[@id='quiz_container']/div[@class='row']" position="inside">
            <t t-if="slide.diligence_external_quiz_url and not slide.question_ids">
                <div class="col-12 o_diligence_external_quiz_preview">
                    <div class="card border-primary shadow-sm">
                        <div class="card-header bg-primary text-white d-flex align-items-center">
                            <i class="fa fa-wpforms fa-2x me-3"/>
                            <span t-out="slide.diligence_external_quiz_label or 'External Quiz / Google Form'"/>
                        </div>
                        <div class="card-body p-0">
                            <iframe class="w-100 border-0" style="min-height: 680px;"
                                    t-att-src="slide.diligence_external_quiz_url"
                                    title="External quiz form" allow="fullscreen"/>
                        </div>
                        <div class="card-footer text-center">
                            <a class="btn btn-primary" target="_blank" rel="noopener noreferrer"
                               t-att-href="slide.diligence_external_quiz_url">
                                <i class="fa fa-external-link me-1"/> Open form in a new tab
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
