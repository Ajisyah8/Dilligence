<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Community-compatible settings view. It uses the standard form and
         avoids Enterprise-only settings app metadata. -->
    <record id="res_config_settings_view_diligence_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.diligence.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <div class="app_settings_block" data-key="general_settings" data-string="Evolution WhatsApp">
                    <h2>Evolution WhatsApp</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="diligence_whatsapp_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="diligence_whatsapp_enabled" string="Enable Evolution WhatsApp"/>
                                <div class="text-muted">Enable WhatsApp messages through Evolution API.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="diligence_whatsapp_api_url" string="Evolution API URL"/>
                                <field name="diligence_whatsapp_api_url" placeholder="https://..."/>
                                <label for="diligence_whatsapp_instance" string="Evolution Instance"/>
                                <field name="diligence_whatsapp_instance"/>
                                <label for="diligence_whatsapp_api_key" string="Evolution API Key"/>
                                <field name="diligence_whatsapp_api_key" password="True"/>
                                <label for="diligence_whatsapp_default_country_code" string="Default Country Code"/>
                                <field name="diligence_whatsapp_default_country_code"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="diligence_whatsapp_signup_message" string="Signup Welcome Message"/>
                                <field name="diligence_whatsapp_signup_message" placeholder="Welcome message"/>
                                <label for="diligence_whatsapp_test_message" string="Test WhatsApp Message"/>
                                <field name="diligence_whatsapp_test_message" placeholder="Test message"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="diligence_whatsapp_send_on_payment" string="Payment Confirmation"/>
                                <field name="diligence_whatsapp_send_on_payment"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
