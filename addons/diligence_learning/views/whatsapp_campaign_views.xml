<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="diligence_whatsapp_campaign_view_list" model="ir.ui.view">
        <field name="name">diligence.whatsapp.campaign.list</field>
        <field name="model">diligence.whatsapp.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="event_id"/>
                <field name="survey_id"/>
                <field name="state"/>
                <field name="pending_count"/>
                <field name="sent_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>
    <record id="diligence_whatsapp_campaign_line_view_list" model="ir.ui.view">
        <field name="name">diligence.whatsapp.campaign.line.list</field>
        <field name="model">diligence.whatsapp.campaign.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="id asc">
                <field name="campaign_id"/>
                <field name="recipient_name" string="Recipient"/>
                <field name="registration_id" string="Event Registration"/>
                <field name="partner_id" string="Contact"/>
                <field name="phone"/>
                <field name="state"/>
                <field name="sent_at"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>
    <record id="action_diligence_whatsapp_campaign_lines" model="ir.actions.act_window">
        <field name="name">WhatsApp Campaign Deliveries</field>
        <field name="res_model">diligence.whatsapp.campaign.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="diligence_whatsapp_campaign_line_view_list"/>
        <field name="domain">[('campaign_id', '=', active_id)]</field>
        <field name="limit">80</field>
    </record>
    <record id="diligence_whatsapp_campaign_view_form" model="ir.ui.view">
        <field name="name">diligence.whatsapp.campaign.form</field>
        <field name="model">diligence.whatsapp.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare" type="object" string="Prepare Recipients" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Send Campaign" class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_reset_draft" type="object" string="Return to Draft" class="btn-secondary" invisible="state == 'draft' or sent_count &gt; 0" confirm="This clears the prepared delivery list. Continue?"/>
                    <button name="action_delete_campaign" type="object" string="Delete Campaign" class="btn-danger" invisible="sent_count &gt; 0" confirm="Delete this campaign and its unsent delivery records? This cannot be undone."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,prepared,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="event_id" readonly="state != 'draft'"/>
                        <field name="audience_segment_id" readonly="state != 'draft'"/>
                        <field name="survey_id" readonly="state != 'draft'"/>
                        <field name="survey_url" readonly="state != 'draft'"/>
                <field name="partner_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                        <field name="message_template" placeholder="Halo %%(name)s..." readonly="state != 'draft'"/>
                    </group>
                    <group string="Delivery Summary">
                        <field name="pending_count"/>
                        <field name="sent_count"/>
                        <field name="error_count"/>
                    </group>
                    <notebook>
                        <page string="Deliveries">
                            <button name="%(action_diligence_whatsapp_campaign_lines)d" type="action" string="Open Full Delivery List" class="btn-secondary" icon="fa-list"/>
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="recipient_name" string="Recipient"/>
                                    <field name="registration_id"/>
                                    <field name="partner_id"/>
                                    <field name="phone"/>
                                    <field name="state"/>
                                    <field name="sent_at"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_diligence_whatsapp_campaign" model="ir.actions.act_window">
        <field name="name">WhatsApp Campaigns</field>
        <field name="res_model">diligence.whatsapp.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_diligence_whatsapp_campaign" name="WhatsApp Campaigns"
              parent="sale.menu_sale_report" action="action_diligence_whatsapp_campaign"
              sequence="20" groups="sales_team.group_sale_manager"/>
</odoo>
